# Copy this file to .env.dbbyte and fill in your DBByte settings.
# Dashboard: https://dashboard.dbbyte.com/
# Never commit your .env.dbbyte file to GitHub.

# S3 Endpoint provided in your DBByte dashboard (e.g., https://s3.dbbyte.com or https://endpoint.dbbyte.com)
DBBYTE_ENDPOINT=https://s3.dbbyte.com
DBBYTE_REGION=us-east-1
DBBYTE_BUCKET=ruqyah-media
DBBYTE_ACCESS_KEY_ID=
DBBYTE_SECRET_ACCESS_KEY=

# Public CDN or Custom Domain base URL for serving assets on your website
# e.g., https://cdn.dbbyte.com/ruqyah-media or https://media.yourdomain.com
DBBYTE_PUBLIC_BASE_URL=
