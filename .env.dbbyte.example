# Copy this file to .env.dbbyte and fill in your DBByte settings.
# Dashboard: https://dashboard.dbbyte.com/
# Never commit your .env.dbbyte file to GitHub.

# --- Account 1 (Default) ---
DBBYTE_API_KEY=
DBBYTE_BUCKET=ruqyah-media
DBBYTE_REGION=us-west-1
DBBYTE_PUBLIC_BASE_URL=

# --- Account 2 ---
DBBYTE_2_API_KEY=
DBBYTE_2_BUCKET=ruqyah-social
DBBYTE_2_REGION=ap-southeast-1
DBBYTE_2_PUBLIC_BASE_URL=

# --- Account 3 ---
DBBYTE_3_API_KEY=
DBBYTE_3_BUCKET=mo-vlogs
DBBYTE_3_REGION=eu-west-1
DBBYTE_3_PUBLIC_BASE_URL=

# --- Account 4 ---
DBBYTE_4_API_KEY=
DBBYTE_4_BUCKET=ruqyah-op
DBBYTE_4_REGION=us-east-1
DBBYTE_4_PUBLIC_BASE_URL=
