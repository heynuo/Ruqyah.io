# Copy this file to .env.imagekit and fill in your ImageKit credentials from:
# https://imagekit.io/dashboard/developer/api-keys
# Never commit your .env.imagekit file to GitHub.

# --- ImageKit Account 1 ---
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/fjx6vpmqa

# --- ImageKit Account 2 (Backup / Secondary) ---
IMAGEKIT_2_PUBLIC_KEY=
IMAGEKIT_2_PRIVATE_KEY=
IMAGEKIT_2_URL_ENDPOINT=https://ik.imagekit.io/6vyidckdo
