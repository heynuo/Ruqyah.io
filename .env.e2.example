# Copy this file to .env.e2 and fill in your IDrive e2 settings.
# Never commit your .env.e2 file to GitHub.

# --- IDrive e2: Singapore 2 (ap-southeast-2) ---
E2_ENDPOINT=https://s3.ap-southeast-2.idrivee2.com
E2_REGION=ap-southeast-2
E2_BUCKET=ruqyah-media
E2_ACCESS_KEY_ID=
E2_SECRET_ACCESS_KEY=

# --- IDrive e2: Milan (eu-south-1) ---
E2_MILAN_ENDPOINT=https://s3.eu-south-1.idrivee2.com
E2_MILAN_REGION=eu-south-1
E2_MILAN_BUCKET=ruqyah-media-milan
# If your access key has "All Buckets" permission, you can leave these empty to reuse the key above:
E2_MILAN_ACCESS_KEY_ID=
E2_MILAN_SECRET_ACCESS_KEY=
