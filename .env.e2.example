# Copy this file to .env.e2 and fill in values from IDrive e2.
# Never commit your .env.e2 file to GitHub.

# From your IDrive e2 Dashboard (Singapore 2 region):
E2_ENDPOINT=https://s3.ap-southeast-2.idrivee2.com
E2_REGION=ap-southeast-2
E2_BUCKET=
E2_ACCESS_KEY_ID=
E2_SECRET_ACCESS_KEY=

# Optional: If you use a custom domain or public endpoint for direct media delivery
# E2_PUBLIC_BASE_URL=
