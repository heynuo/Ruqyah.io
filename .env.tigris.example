# Copy this file to .env.tigris and fill in your Tigris credentials.
# Never commit your .env.tigris file to GitHub.

# From your Tigris Console (https://console.tigris.dev/):
TIGRIS_ENDPOINT=https://t3.storage.dev
TIGRIS_REGION=auto
TIGRIS_BUCKET=ruqyah-media
TIGRIS_ACCESS_KEY_ID=
TIGRIS_SECRET_ACCESS_KEY=

# Optional: If you use a custom domain or Tigris public bucket URL
# TIGRIS_PUBLIC_BASE_URL=
