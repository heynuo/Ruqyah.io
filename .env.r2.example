# Copy this file to .env.r2 and fill in values from Cloudflare R2.
# The API bearer token pasted in chat is not an S3 credential; create an R2
# Object Read & Write API token scoped to this bucket and use its S3 credentials.
R2_ACCOUNT_ID=
R2_BUCKET=ruqyah-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# A public custom domain connected to this R2 bucket, for example:
# https://media.example.com
R2_PUBLIC_BASE_URL=
